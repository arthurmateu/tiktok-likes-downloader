{
	"manifest_version": 3,
	"name": "TikTok Likes Archiver",
	"version": "1.0.1",
	"description": "Archive your liked TikToks — videos and photo posts — into a folder you choose. No limits, no purchases.",
	"minimum_chrome_version": "111",
	"key": "",
	"permissions": ["storage", "unlimitedStorage", "tabs", "scripting", "declarativeNetRequest", "nativeMessaging", "offscreen"],
	"host_permissions": [
		"*://*.tiktok.com/*",
		"*://*.tiktokcdn.com/*",
		"*://*.tiktokcdn-us.com/*",
		"*://*.tiktokcdn-eu.com/*",
		"*://*.tiktokcdn.us/*",
		"*://*.tiktokv.com/*",
		"*://*.tiktokv.us/*",
		"*://*.ttwstatic.com/*",
		"*://*.byteoversea.com/*",
		"*://*.ibytedtos.com/*",
		"*://*.muscdn.com/*",
		"*://*.isnssdk.com/*",
		"http://127.0.0.1/*"
	],
	"background": {
		"service_worker": "src/background.js",
		"type": "module"
	},
	"action": {
		"default_title": "TikTok Likes Archiver",
		"default_popup": "src/popup/popup.html"
	},
	"content_scripts": [
		{
			"matches": ["*://*.tiktok.com/*"],
			"js": ["src/content/hook.js"],
			"run_at": "document_start",
			"world": "MAIN",
			"all_frames": false
		},
		{
			"matches": ["*://*.tiktok.com/*"],
			"js": ["src/content/collector.js"],
			"run_at": "document_start",
			"world": "ISOLATED",
			"all_frames": false
		},
		{
			"_comment": "The viewer.html written into the archive folder. Inert unless the page carries our meta tag. Opened from disk it is dead entirely until the user turns on 'Allow access to file URLs' — Chromium will not run an extension on a local file otherwise; served by the local helper on 127.0.0.1 it needs nothing. Firefox has no equivalent and rejects file:// match patterns, so manifest.firefox.json has no counterpart to this.",
			"matches": ["file:///*", "http://127.0.0.1/*"],
			"js": ["src/content/viewer-bridge.js"],
			"run_at": "document_idle",
			"world": "ISOLATED",
			"all_frames": false
		}
	],
	"web_accessible_resources": [
		{
			"_comment": "So a generated viewer.html can link back to the archive page, opened from disk or served by the local helper.",
			"resources": ["src/archive/archive.html"],
			"matches": ["file:///*", "http://127.0.0.1/*"]
		}
	],
	"declarative_net_request": {
		"rule_resources": [
			{
				"id": "cdn_referer",
				"enabled": true,
				"path": "rules/dnr.json"
			}
		]
	}
}
